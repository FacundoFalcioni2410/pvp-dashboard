# Local development defaults. Vercel is detected automatically and enables secure cookies/HSTS.
PVP_ENV=development
PVP_COOKIE_SECURE=false
PVP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PVP_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
PVP_SESSION_HOURS=8
PVP_MAX_UPLOAD_MB=25
PVP_MAX_EXCEL_UNCOMPRESSED_MB=200

# Turso (the DATABASE_* names are provided by the Vercel integration)
DATABASE_TURSO_DATABASE_URL=libsql://your-database.turso.io
DATABASE_TURSO_AUTH_TOKEN=replace-with-a-secret-token

# For a custom production domain, override PVP_ALLOWED_ORIGINS and PVP_ALLOWED_HOSTS
# in Vercel with the HTTPS origin and hostname for that domain.
